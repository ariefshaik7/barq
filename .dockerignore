# Keep the build context small and the image reproducible.
#
# The reference implementations that the design was informed by are
# never part of the build context.

# The Woodpecker CI checkout used as an architectural reference.
woodpecker/

# The specification document.
spec.md

# Local state and secrets.
.env
.env.*
*.pem
*.key
secrets/

# Build artefacts.
dist/
bin/
*.test
coverage.out
coverage.html

# Editor and OS noise.
.DS_Store
.idea/
.vscode/
*.swp
